{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ExoDeck: Go (run)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": ["-cl", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "env": {}
    },
    {
      "name": "ExoDeck: Go (debug)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": ["-cl", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "env": {}
    }
  ]
}
